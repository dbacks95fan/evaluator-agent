{
  "name": "evaluator-agent",
  "version": "0.1.0",
  "description": "Independent Codex-based evaluator for coding-agent results.",
  "type": "module",
  "bin": {
    "evaluator-agent": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
