EVALUATOR_HTTP_PORT=8080
EVALUATOR_API_TOKEN=replace-with-a-long-random-token
OPENAI_API_KEY=replace-with-an-openai-api-key
EVALUATOR_ALLOWED_REPOSITORY_URLS=https://github.com/<owner>/<product-repo>.git
EVALUATOR_GITHUB_APP_ID=replace-with-github-app-id
EVALUATOR_GITHUB_APP_INSTALLATION_ID=replace-with-installation-id
EVALUATOR_GITHUB_APP_PRIVATE_KEY_FILE=/run/secrets/github-app.pem
# Compose host path; keep the private key outside the repository.
EVALUATOR_GITHUB_APP_PRIVATE_KEY_HOST_PATH=/path/to/evaluator-agent/github-app.pem
