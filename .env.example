# ABOUTME: Runtime settings template. Copy to C:\Repos\.config\evaluator-agent\runtime.env, outside the repository;
# ABOUTME: set-nas-secrets.ps1 sends it to the NAS. Never commit real values.
# OpenAI API key; the evaluator calls the Responses API directly (no Codex CLI).
OPENAI_API_KEY=replace-with-an-openai-api-key
# GitHub App for the driver's Git calls on product repositories (Contents read/write, installed on product repos only).
# Each call gets a one-hour token for its one repository: write only to publish the Evaluation Package, read otherwise.
EVALUATOR_GITHUB_APP_ID=replace-with-the-numeric-app-id
EVALUATOR_GITHUB_APP_INSTALLATION_ID=replace-with-the-numeric-installation-id
# Path to the app's .pem private key on this PC. set-nas-secrets.ps1 sends the file itself to the NAS.
EVALUATOR_GITHUB_APP_PRIVATE_KEY_FILE=replace-with-the-path-to-the-private-key.pem
# Shared bearer token the Conductor sends.
EVALUATOR_API_TOKEN=replace-with-a-long-random-token
EVALUATOR_GIT_NAME=evaluator-agent
EVALUATOR_GIT_EMAIL=evaluator-agent@users.noreply.github.com
# Optional overrides (defaults shown).
# EVALUATOR_MODEL=gpt-6.1-sol
# EVALUATOR_REASONING_EFFORT=
# EVALUATOR_MAX_TURNS=40
# EVALUATOR_MAX_RUNTIME_MIN=30
# EVALUATOR_CHECK_TIMEOUT_MIN=15
# EVALUATOR_SETUP_TIMEOUT_MIN=20
