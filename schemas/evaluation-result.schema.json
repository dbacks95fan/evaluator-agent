{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/evaluation-result.schema.json",
  "title": "Evaluation Result v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["workItem", "status", "summary", "acceptanceCriteria", "findings", "risks", "scope", "preflight", "traceability", "recommendation"],
  "properties": {
    "workItem": { "type": "string", "minLength": 1 },
    "status": { "enum": ["pass", "fail", "needs_decision"] },
    "summary": { "type": "string", "minLength": 1 },
    "acceptanceCriteria": { "type": "object", "additionalProperties": false, "required": [], "properties": {} },
    "findings": { "type": "array" },
    "risks": { "type": "array", "items": { "type": "string" } },
    "scope": { "type": "object", "additionalProperties": false, "required": ["status", "unexpectedChanges"], "properties": { "status": { "enum": ["acceptable", "unexpected_changes", "not_verified"] }, "unexpectedChanges": { "type": "array", "items": { "type": "string" } } } },
    "preflight": { "type": "object", "additionalProperties": false, "required": ["status", "facts", "inferences", "decisionsRequired"], "properties": { "status": { "enum": ["pass", "needs_decision"] }, "facts": { "type": "array", "items": { "type": "string" } }, "inferences": { "type": "array", "items": { "type": "string" } }, "decisionsRequired": { "type": "array", "items": { "type": "string" } } } },
    "traceability": { "type": "object", "additionalProperties": false, "required": ["intentPath", "intentRevision", "intentHash", "contractHash", "evidenceRunId", "boardWorkItemUrl"], "properties": { "intentPath": { "type": "string" }, "intentRevision": { "type": "string" }, "intentHash": { "type": "string" }, "contractHash": { "type": "string" }, "evidenceRunId": { "type": "string" }, "boardWorkItemUrl": { "type": "string" } } },
    "decisionBrief": { "type": "object", "additionalProperties": false, "required": ["decisionRequired", "whyNow", "knownFacts", "evaluatorInferences", "options", "consequenceOfNoDecision"], "properties": { "decisionRequired": { "type": "string" }, "whyNow": { "type": "string" }, "knownFacts": { "type": "array", "items": { "type": "string" } }, "evaluatorInferences": { "type": "array", "items": { "type": "string" } }, "options": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["option", "impact"], "properties": { "option": { "type": "string" }, "impact": { "type": "string" } } } }, "consequenceOfNoDecision": { "type": "string" } } },
    "recommendation": { "enum": ["human_approval", "return_to_coding_agent", "human_decision"] }
  }
}
