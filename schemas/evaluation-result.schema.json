{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/evaluation-result.schema.json",
  "title": "Evaluation Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["workItem", "status", "summary", "acceptanceCriteria", "findings", "risks", "scope", "recommendation"],
  "properties": {
    "workItem": { "type": "string", "minLength": 1 },
    "status": { "enum": ["pass", "fail", "needs_decision"] },
    "summary": { "type": "string", "minLength": 1 },
    "acceptanceCriteria": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status", "evidence", "explanation"],
        "properties": {
          "status": { "enum": ["pass", "fail", "partial", "not_verified"] },
          "evidence": { "type": "array", "items": { "type": "string" } },
          "explanation": { "type": "string", "minLength": 1 }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "severity", "type", "problem", "evidence"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "severity": { "enum": ["critical", "high", "medium", "low"] },
          "type": { "enum": ["acceptance_criteria", "defect", "regression", "scope", "test_quality", "architecture", "security", "risk", "other"] },
          "criterion": { "type": "string" },
          "file": { "type": "string" },
          "line": { "type": "integer", "minimum": 1 },
          "problem": { "type": "string", "minLength": 1 },
          "evidence": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "expectedBehavior": { "type": "string" }
        }
      }
    },
    "risks": { "type": "array", "items": { "type": "string" } },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "unexpectedChanges"],
      "properties": {
        "status": { "enum": ["acceptable", "unexpected_changes", "not_verified"] },
        "unexpectedChanges": { "type": "array", "items": { "type": "string" } }
      }
    },
    "recommendation": { "enum": ["human_approval", "return_to_coding_agent", "human_decision"] }
  }
}
